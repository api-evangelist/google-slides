  "info": {
    "_postman_id": "0c111c02-1195-4c5b-b692-73362ec0961f",
    "name": "Google Slides Pages API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Reads and writes Google Slides presentations. The Google Slides API lets you create and modify Google Slides presentations. Apps can integrate with the Slides API to create presentations, add and modify slides, format text and shapes, embed charts and images, and perform batch updates to presentations programmatically.\n\n\nContact Support:\n Name: Google Workspace Developer Support",
      "type": "text/plain"
    }
  }
