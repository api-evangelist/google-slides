                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "thumbnailProperties.mimeType",
                  "value": "<string>",
                  "description": "The optional mime type of the thumbnail image. If you don't specify the mime type, the mime type defaults to PNG.\n"
                },
                {
                  "disabled": false,
                  "key": "thumbnailProperties.thumbnailSize",
                  "value": "<string>",
                  "description": "The optional thumbnail image size. If you don't specify the size, the server chooses a default size of the image.\n"
